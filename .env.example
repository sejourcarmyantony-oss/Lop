# Copie ce fichier en ".env" et remplis tes propres valeurs.
# Sur Render, ajoute ces mêmes variables dans Dashboard > Environment.

# Numéro WhatsApp du bot, indicatif inclus, SANS le "+" (ex: 50931277118)
# Nécessaire sur Render car il n'y a pas de terminal interactif pour taper le numéro.
OWNER_PHONE=50931277118

# Port HTTP (Render le fournit automatiquement, ne pas modifier en général)
PORT=3000

# Clé API pour les commandes IA (.ai, .chatbot, .gpt, etc.)
# Exemple avec l'API Anthropic : https://console.anthropic.com/
AI_API_KEY=

# Clé API optionnelle pour la génération d'images (.imagine, .dalle, .flux...)
IMAGE_API_KEY=

# Clé API optionnelle pour la reconnaissance musicale (.shazam) — ex: audd.io
AUDD_API_KEY=
